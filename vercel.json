{
  "buildCommand": "node -e \"require('fs').writeFileSync('env.js','window.__ENV__={DATABASE_URL:'+JSON.stringify(process.env.DATABASE_URL||'')+'};')\"",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/admin.html",      "destination": "/app/admin.html" },
    { "source": "/asistencia.html", "destination": "/app/asistencia.html" }
  ]
}
